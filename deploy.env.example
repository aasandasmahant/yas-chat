# Copy this file to .env on the server. Never commit real secrets.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Exact public HTTPS origin, with no trailing slash (example: https://chat.example.com)
WEB_ORIGIN=https://YOUR_PUBLIC_DOMAIN
APP_PORT=3000
