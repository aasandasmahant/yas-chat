# Copy to .env on the server. Never commit real secrets.
DOMAIN=your-domain.example
WEB_ORIGIN=https://your-domain.example
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Generate with: openssl rand -hex 32 (required to save provider credentials in Admin)
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
